{
  "name": "codeswim-monorepo",
  "version": "0.1.2",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Diagram-first code navigator monorepo.",
  "author": "Keith Groves",
  "license": "MIT",
  "homepage": "https://github.com/keithagroves/codeswim",
  "repository": {
    "type": "git",
    "url": "https://github.com/keithagroves/codeswim.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @codeswim/desktop",
    "start": "npm run start --workspace @codeswim/desktop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "build:mac": "npm run build:mac --workspace @codeswim/desktop",
    "build:win": "npm run build:win --workspace @codeswim/desktop",
    "build:linux": "npm run build:linux --workspace @codeswim/desktop",
    "build:unpack": "npm run build:unpack --workspace @codeswim/desktop",
    "party:dev": "wrangler dev --var REQUIRE_AUTH:false",
    "party:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "partyserver": "^0.0.74",
    "playwright-core": "^1.61.0",
    "prettier": "^3.7.4",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.40.0"
  }
}
