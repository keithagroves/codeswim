{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": ["^build"],
      // Build-time env baked into the bundle by vite (renderer: VITE_*,
      // main: MAIN_VITE_*). Declared here so Turbo passes them through to the
      // task AND keys the cache on them — otherwise a changed host replays a
      // stale build and the app ships pointing at 127.0.0.1.
      "env": ["VITE_PARTY_HOST", "MAIN_VITE_GITHUB_CLIENT_ID"],
      "outputs": ["out/**", "dist/**"]
    }
  }
}
