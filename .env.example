# Copy to .env (gitignored) and fill in.

# GitHub OAuth App client id (Device Flow enabled). Not a secret. Enables
# "Sign in with GitHub" in chat. Injected into the main process by electron-vite
# via the MAIN_VITE_ prefix. (A shell `GITHUB_CLIENT_ID=...` also works.)
MAIN_VITE_GITHUB_CLIENT_ID=

# Host of the deployed PartyServer chat worker (no scheme, no trailing slash).
# Leave unset for local development — the client defaults to the local
# `wrangler dev` server at 127.0.0.1:8788.
#
# For production builds, set this (here or in .env.production) to the host
# printed by `npm run party:deploy`, e.g.:
# VITE_PARTY_HOST=codeswim.hidden-haze-1847.workers.dev
#
# Set the *same* host again with the MAIN_VITE_ prefix — the renderer talks
# to the party server directly (VITE_PARTY_HOST), but the main process also
# needs it to point the in-app agent's chat_read/chat_send tools at the right
# server (see src/main/index.ts's `harness:start` handler).
# MAIN_VITE_PARTY_HOST=codeswim.hidden-haze-1847.workers.dev
