{
  "name": "@codeswim/desktop",
  "version": "0.1.5",
  "description": "Diagram-first code navigator: browse a codebase as a hierarchy of mermaid diagrams.",
  "main": "./out/main/index.js",
  "author": "Keith Groves",
  "license": "MIT",
  "homepage": "https://github.com/keithagroves/codeswim",
  "repository": {
    "type": "git",
    "url": "https://github.com/keithagroves/codeswim.git"
  },
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:harness": "node scripts/build-harness.mjs",
    "watch:harness": "node scripts/build-harness.mjs --watch",
    "build": "npm run typecheck && npm run build:harness && electron-vite build",
    "smoke": "node scripts/smoke-electron.mjs",
    "capture-demo": "node scripts/capture-demo.mjs",
    "rebuild-deps": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:signed": "npm run build && electron-builder --mac -c.mac.notarize=true",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@codeswim/commit": "*",
    "@codeswim/contract": "*",
    "@codeswim/coverage": "*",
    "@codeswim/domain-git": "*",
    "@codeswim/domain-github": "*",
    "@codeswim/domain-kanban": "*",
    "@codeswim/domain-skills": "*",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@opencode-ai/sdk": "^1.14.46",
    "chokidar": "^5.0.0",
    "ghostty-web": "^0.4.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "mermaid": "^11.14.0",
    "node-pty": "^1.1.0",
    "opencode-ai": "^1.14.46"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.46",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
